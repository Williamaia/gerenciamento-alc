# Copie para .env na implantação. Não grave segredos neste arquivo.

# Serviço HTTP
HOST=0.0.0.0
PORT=8000
# Quando o serviço estiver acessível de fora, coloque a origem pública, sem barra no final.
# A URL do webhook será PUBLIC_BASE_URL + /webhooks/evolution
PUBLIC_BASE_URL=

# Evolution API. A versão efetiva será conferida na implementação.
EVOLUTION_API_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WEBHOOK_SECRET=

# PostgreSQL
DATABASE_URL=

# Provedor e modelo ficam configuráveis. A spec não fixa fornecedor.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# Números e grupos são dados, não literais de código.
# Vários administradores separados por vírgula.
WHATSAPP_ADMIN_NUMBERS=
WHATSAPP_ORIGIN_GROUP_ID=
WHATSAPP_CONTROL_GROUP_ID=

# Fuso dos fatos de negócio e do agendamento.
DEFAULT_TIMEZONE=America/Sao_Paulo

# Arquivos e backup ficam fora de acesso público.
DOCUMENT_STORAGE_PATH=
BACKUP_PATH=
BACKUP_RETENTION_DAYS=30
